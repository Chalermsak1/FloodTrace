# ==============================================================================
# FLOODTRACE / RUWAIGON — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to '.env' on the production host and populate secrets before launching.
# ==============================================================================

# --- System & Deployment Environment ---
ENVIRONMENT=production
DATA_ENV=PRODUCTION
REQUIRE_PRIVATE_ACCESS_FOR_PRODUCTION=false
ALLOW_OFFICIAL_PUBLIC_PRODUCTION=true

# --- Public Domain & HTTPS ---
# The public FQDN where the platform is accessed (e.g. floodtrace.yourdomain.com)
DOMAIN=floodtrace.yourdomain.com
WEB_PORT=80
WEB_SSL_PORT=443

# --- CORS Allowed Origins ---
# Comma-separated list of allowed HTTPS origins for browser requests
BACKEND_CORS_ORIGINS=https://floodtrace.yourdomain.com,https://www.floodtrace.yourdomain.com

# --- Production Spatial Database (PostgreSQL 16 + PostGIS 3.4+) ---
POSTGRES_USER=floodtrace_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_64_CHAR_PASSWORD
POSTGRES_DB=floodtrace_db
DATABASE_URL=postgresql+psycopg://floodtrace_user:REPLACE_WITH_STRONG_RANDOM_64_CHAR_PASSWORD@db:5432/floodtrace_db

# Connection Pool Limits
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=15000

# --- Security & Staff Authentication ---
# Secret key for Staff Console operations (min 32 characters, high entropy)
ADMIN_API_KEY=REPLACE_WITH_STRONG_RANDOM_ADMIN_API_KEY

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
SUBMIT_RATE_LIMIT_PER_MINUTE=10
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB max per citizen evidence photo
DATA_RETENTION_DAYS=365
COORDINATE_GENERALIZE_DECIMALS=2 # ~1.1km blur for public coordinates

# --- Telemetry Scheduler & External Feeds ---
ENABLE_SCHEDULER=true
# Optional private agency tokens (leave blank if utilizing verified OpenGov feeds)
THAIWATER_API_KEY=
GISTDA_API_KEY=
TMD_API_KEY=

# --- Institutional Governance & Responsible Contacts ---
PROJECT_OWNER="FloodTrace Operational Consortium (Prachin Buri)"
INSTITUTION="Prachin Buri Environmental Watch Network"
PUBLIC_CONTACT="contact@floodtrace.org"
PRIVACY_CONTACT="privacy@floodtrace.org"
SECURITY_CONTACT="security@floodtrace.org"
LEGAL_CONTACT="legal@floodtrace.org"
