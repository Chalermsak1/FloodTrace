# ==============================================================================
# FLOODTRACE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to '.env.production' on your production server.
#
# IMPORTANT: Never commit '.env.production' or real credentials into git.
# All fields below must be populated with cryptographically secure values.
# ==============================================================================

# --- 1. System & Deployment Environment ---
ENVIRONMENT=production
DATA_ENV=PRODUCTION
REQUIRE_PRIVATE_ACCESS_FOR_PRODUCTION=false
ALLOW_OFFICIAL_PUBLIC_PRODUCTION=true

# --- 2. Production Domain & Public URL ---
# Specify your registered fully-qualified domain name (e.g. floodtrace.yourorg.th)
DOMAIN=REPLACE_WITH_YOUR_REGISTERED_DOMAIN
# The public URL accessed by browsers (used for CORS and canonical links)
PUBLIC_BASE_URL=https://REPLACE_WITH_YOUR_REGISTERED_DOMAIN
WEB_PORT=80
WEB_SSL_PORT=443

# --- 3. CORS Allowed Origins ---
# Comma-separated list of allowed origins for browser API access
BACKEND_CORS_ORIGINS=https://REPLACE_WITH_YOUR_REGISTERED_DOMAIN

# --- 4. Cloudflare Named Tunnel (If using Cloudflare Named Tunnel) ---
# Paste your tunnel token generated from 'cloudflared tunnel token <tunnel-name>'
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_WITH_CLOUDFLARE_NAMED_TUNNEL_TOKEN

# --- 5. Production Spatial Database (PostgreSQL 16 + PostGIS 3.4) ---
POSTGRES_USER=floodtrace_prod_user
# Generate a strong 64-character random password: openssl rand -base64 48
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_64_CHAR_PASSWORD
POSTGRES_DB=floodtrace_db
DATABASE_URL=postgresql+psycopg://floodtrace_prod_user:REPLACE_WITH_STRONG_RANDOM_64_CHAR_PASSWORD@db:5432/floodtrace_db

# Connection Pool & Statement Limits
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=25
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=15000

# --- 6. Security, Keys & Staff Authentication ---
# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MIN_32_CHARS
# Staff Console API Key: openssl rand -hex 32
ADMIN_API_KEY=REPLACE_WITH_STRONG_RANDOM_ADMIN_API_KEY_MIN_32_CHARS

# Rate Limiting & Upload Quotas
RATE_LIMIT_PER_MINUTE=120
SUBMIT_RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB max per citizen evidence image
DATA_RETENTION_DAYS=365
COORDINATE_GENERALIZE_DECIMALS=2 # ~1.1km blur for public coordinates

# --- 7. Automated Scheduler & Telemetry ---
ENABLE_SCHEDULER=true
# Optional external private agency tokens (leave blank if utilizing open gov endpoints)
THAIWATER_API_KEY=
GISTDA_API_KEY=
TMD_API_KEY=
DIW_AUTHORIZED_CREDENTIAL=
RID_PRIVATE_TOKEN=
PCD_LAB_MOU=

# --- 8. Project Governance & Public Contacts ---
PROJECT_OWNER="FloodTrace Operational Consortium (Prachin Buri)"
INSTITUTION="Prachin Buri Environmental & Hydrological Surveillance Platform"
PUBLIC_CONTACT="contact@REPLACE_WITH_YOUR_REGISTERED_DOMAIN"
PRIVACY_CONTACT="privacy@REPLACE_WITH_YOUR_REGISTERED_DOMAIN"
SECURITY_CONTACT="security@REPLACE_WITH_YOUR_REGISTERED_DOMAIN"
LEGAL_CONTACT="legal@REPLACE_WITH_YOUR_REGISTERED_DOMAIN"
