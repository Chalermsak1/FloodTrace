[Unit]
Description=FloodTrace Production Container Stack
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/floodtrace
EnvironmentFile=-/opt/floodtrace/.env.production
ExecStart=/usr/bin/docker compose --env-file /opt/floodtrace/.env.production -f /opt/floodtrace/deploy/production/docker-compose.prod.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /opt/floodtrace/.env.production -f /opt/floodtrace/deploy/production/docker-compose.prod.yml down
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
